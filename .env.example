# Required
LEAGUE_ID=your_sleeper_league_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional (defaults shown)
TIMEZONE=America/New_York
CLOSE_SCORES_THRESHOLD=15
DAILY_WAIVER=false
MONITOR_REPORT=true
INIT_MSG='Fantasy bot is online.'
# Manual 4-letter team codes for scoreboard-style reports, keyed by Sleeper
# roster ID. Teams not listed fall back to a code auto-derived from their
# team/display name.
# TEAM_ABBREVIATIONS='{"1":"DYNK","2":"ALMO","3":"VICT","4":"WOLF"}'

# AI Weekly Recap (optional). Set LLM_API_KEY to enable an AI-written
# commissioner's newsletter posted Tuesday evenings (see -report=recap to
# run it on demand) covering streaks, season head-to-head, the playoff race,
# and the week's worst lineup decision. Leave LLM_API_KEY unset to disable it
# entirely - LLM_PROVIDER and LLM_MODEL are only required once it's set.
#
# LLM_PROVIDER must be one of: anthropic, openai, gemini
# LLM_MODEL is the provider's model name, e.g.:
#   anthropic -> claude-sonnet-5
#   openai    -> gpt-5.1
#   gemini    -> gemini-3.1-pro-preview (gemini-2.5-pro is deprecated for new users)
#
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your_api_key
# LLM_MODEL=claude-sonnet-5

# Web config portal (optional). Set PORTAL_PASSWORD to enable a small
# password-protected web UI (see README.md's "Web Portal" section) for
# turning individual scheduled messages on/off, changing the waiver
# report's day(s), the timezone, and the AI weekly recap's prompt, all
# without editing .env or restarting the bot. Leave PORTAL_PASSWORD unset
# to disable the portal entirely (the default).
#
# PORTAL_PASSWORD=choose_a_password
# PORTAL_PORT=8080
# SETTINGS_FILE=data/settings.json
